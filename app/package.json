{
  "name": "spqr-sgao",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names client,server --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "docker:up": "docker compose --env-file server/.env up --build",
    "docker:db": "docker compose --env-file server/.env up db",
    "docker:down": "docker compose --env-file server/.env down",
    "docker:reset": "docker compose --env-file server/.env down -v",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "npm run check-types --workspaces",
    "prepare": "cd .. && husky app/.husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
