# DEVELOPMENT configuration (everything on localhost).
# Copy to .env and adjust. Never commit .env.
# The production configuration will be added in epic L.
#
# development: raw errors for debugging. Anything else (test, production) or unset: safety net on 5xx errors.
NODE_ENV="development"
# Port of the API (the client calls it through NEXT_PUBLIC_API_URL)
APP_PORT="3001"

# PostgreSQL connection (development database).
# localhost when the API runs on your machine; Docker Compose will override DB_HOST with the service name.
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="spqr"
DB_PASSWORD="change-me"
DB_NAME="sgao"

# Comma-separated list of origins allowed by CORS: the address of the client (next dev uses port 3000)
ALLOWED_ORIGINS="http://localhost:3000"

# Secret used to sign JWTs. At least 32 characters, different in each environment.
# Generate one with: openssl rand -base64 48
APP_SECRET=""
