# DEVELOPMENT configuration (everything on localhost).
# Copy to .env and adjust. Never commit .env.
# The production configuration will be added in epic L.
#
# development: raw errors for debugging. Anything else (test, production) or unset: safety net on 5xx errors.
NODE_ENV="development"
# Port of the API (the client calls it through API_URL, which must use the same port)
APP_PORT="3001"

# PostgreSQL connection (development database).
# localhost when the API runs on your machine; Docker Compose overrides DB_HOST with the service name.
# DB_PORT is also the port Docker Compose publishes on localhost.
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="spqr"
DB_PASSWORD="change-me"
DB_NAME="sgao"

# Test database (db-test service): other port and other credentials than the development database.
# Every test uses it, never the development database. Read by Docker Compose, not by the API.
TEST_DB_PORT="5433"
TEST_DB_USER="spqr_test"
TEST_DB_PASSWORD="change-me-too"
TEST_DB_NAME="sgao_test"

# Comma-separated list of origins allowed by CORS: the address of the client (next dev uses port 3000)
ALLOWED_ORIGINS="http://localhost:3000"

# Secret used to sign JWTs. At least 32 characters, different in each environment.
# Generate one with: openssl rand -base64 48
APP_SECRET=""
