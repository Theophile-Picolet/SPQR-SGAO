# Copy to .env and adjust. Never commit .env.
# development: raw errors for debugging. Anything else (test, production) or unset: safety net on 5xx errors.
NODE_ENV=""
APP_PORT=""

# PostgreSQL connection (development database)
DB_HOST=""
DB_PORT=""
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=""

# Secret used to sign JWTs. At least 32 characters, different in each environment.
# Generate one with: openssl rand -base64 48
APP_SECRET=""
