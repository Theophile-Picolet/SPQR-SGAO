# DEVELOPMENT configuration (the browser calls the API on localhost).
# Copy to .env.local and adjust. Never commit .env.local.
# The production configuration will be added in epic L.
#
# Base URL of the API, without trailing slash. The API runs on APP_PORT of app/server.
# API_URL is written into the JavaScript at build time (see next.config.mjs): changing it needs a new build.
API_URL="http://localhost:3001"
